{
  "manifest_version": 3,
  "name": "Mudra Smart Cursor",
  "version": "2.0.0",
  "description": "Precision cursor for Mudra HID mouse with local Windows companion status (no BLE scan).",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Toggle Mudra Smart Cursor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ]
}
